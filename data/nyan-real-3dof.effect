// SPDX-License-Identifier: GPL-2.0-or-later
// nyan Real 3DoF source warp. Backward samples the source as a virtual screen.

uniform float4x4 ViewProj;
uniform texture2d image;

// Stored as (w, x, y, z).
uniform float4 pose_q;
uniform float pose_valid;
uniform float2 tan_half_fov;
uniform float screen_distance_m;
uniform float2 screen_half_size_m;
uniform float screen_curve;
// World-space ray origin. (0,0,0) for mono; in SBS output each eye renders
// from its own position (the head-frame ±IPD/2 offset rotated by the pose),
// which converges the screen at screen_distance_m instead of infinity.
uniform float3 eye_pos_m;
uniform float debug_tint;
// Off-screen indicator: unit direction (+x right / +y up) toward the screen and
// 0..1 strength (0 = on-screen). Drawn as an edge glow by nyan_offscreen_glow.
uniform float2 offscreen_dir;
uniform float offscreen_intensity;
uniform float2 offscreen_band;
// Flat-mirror aspect fit (pose_valid == 0): fraction of the per-eye view the
// source fills per axis, so the head-locked mirror is letterboxed, not stretched.
uniform float2 flat_fit;

sampler_state linClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData o;
	o.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	o.uv = v_in.uv;
	return o;
}

// nyan_rotate_by_quat / nyan_warp_uv come from data/nyan_warp.hlsli, which the
// loader prepends to this effect (the libobs effect parser has no #include).

float4 PSWarp(VertData v_in) : TARGET
{
	float3 base;
	if (pose_valid < 0.5) {
		// Head-locked flat mirror: aspect-fit the source (letterbox bars).
		float3 fr = nyan_flat_uv(v_in.uv, flat_fit);
		if (fr.z < 0.5) {
			base = float3(0.0, 0.0, 0.0);
		} else {
			float4 col0 = image.Sample(linClamp, fr.xy);
			if (debug_tint > 0.01)
				col0.rgb = lerp(col0.rgb, float3(0.6, 0.2, 0.0),
						0.18);
			base = col0.rgb;
		}
	} else {
		float3 r = nyan_warp_uv(v_in.uv, pose_q, tan_half_fov,
					screen_distance_m, screen_half_size_m,
					screen_curve, eye_pos_m);
		if (r.z < 0.5) {
			base = float3(0.0, 0.0, 0.0);
		} else {
			float4 col = image.Sample(linClamp, r.xy);
			if (debug_tint > 0.01)
				col.rgb = lerp(col.rgb,
					       float3(0.0, 0.75, 0.45),
					       saturate(debug_tint));
			base = col.rgb;
		}
	}
	base += nyan_offscreen_glow(v_in.uv, offscreen_dir, offscreen_band,
				    offscreen_intensity);
	return float4(base, 1.0);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSWarp(v_in);
	}
}
